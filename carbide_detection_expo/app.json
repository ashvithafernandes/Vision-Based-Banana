{
  "expo": {
    "name": "RipeScan",
    "slug": "carbide-detection-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RipeScan to access your camera to scan bananas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RipeScan to access your photos to analyze fruit images."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ripescan.carbide",
      "adaptiveIcon": {
        "backgroundColor": "#EDF2F6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
